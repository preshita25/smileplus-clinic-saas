generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  INSURANCE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Clinic {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  postalCode    String?
  country       String         @default("India")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  doctors       Doctor[]
  departments   Department[]
  patients      Patient[]
  services      Service[]
  appointments  Appointment[]
  treatments    Treatment[]
  invoices      Invoice[]
  uploadedFiles UploadedFile[]
}

model User {
  id                  String         @id @default(cuid())
  clinicId            String
  name                String
  email               String
  passwordHash        String
  role                UserRole       @default(RECEPTIONIST)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  clinic              Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor              Doctor?
  createdAppointments Appointment[]  @relation("AppointmentCreatedBy")
  receivedPayments    Payment[]      @relation("PaymentReceivedBy")
  uploadedFiles       UploadedFile[] @relation("FileUploadedBy")

  @@unique([clinicId, email])
  @@index([clinicId, role])
}

model Doctor {
  id             String        @id @default(cuid())
  clinicId       String
  userId         String?       @unique
  name           String
  email          String?
  phone          String?
  specialization String?
  licenseNumber  String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  departments    Department[]
  appointments   Appointment[]
  treatments     Treatment[]

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
}

model Department {
  id          String    @id @default(cuid())
  clinicId    String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctors     Doctor[]
  services    Service[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Patient {
  id             String         @id @default(cuid())
  clinicId       String
  patientCode    String
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         Gender?
  phone          String
  email          String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  allergies      String?
  medicalNotes   String?
  isActive       Boolean        @default(true)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  treatments     Treatment[]
  invoices       Invoice[]
  uploadedFiles  UploadedFile[]

  @@unique([clinicId, patientCode])
  @@index([clinicId, phone])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, isActive])
}

model Service {
  id           String        @id @default(cuid())
  clinicId     String
  departmentId String?
  name         String
  description  String?
  durationMins Int           @default(30)
  price        Decimal       @db.Decimal(10, 2)
  currency     String        @default("INR")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  treatments   Treatment[]
  invoiceItems InvoiceItem[]

  @@unique([clinicId, name])
  @@index([clinicId, departmentId])
  @@index([clinicId, isActive])
}

model Appointment {
  id            String            @id @default(cuid())
  clinicId      String
  patientId     String
  doctorId      String
  serviceId     String?
  createdById   String?
  scheduledAt   DateTime
  durationMins  Int               @default(30)
  status        AppointmentStatus @default(SCHEDULED)
  reason        String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  treatment     Treatment?
  invoice       Invoice?
  uploadedFiles UploadedFile[]

  @@index([clinicId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([clinicId, status])
}

model Treatment {
  id            String         @id @default(cuid())
  clinicId      String
  patientId     String
  doctorId      String
  appointmentId String?        @unique
  serviceId     String?
  treatmentDate DateTime       @default(now())
  diagnosis     String?
  notes         String?
  cost          Decimal?       @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  uploadedFiles UploadedFile[]

  @@index([clinicId, treatmentDate])
  @@index([patientId, treatmentDate])
}

model Invoice {
  id            String        @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?       @unique
  invoiceNumber String
  status        String        @default("PENDING")
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  dueAmount     Decimal       @db.Decimal(10, 2)
  currency      String        @default("INR")
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, status])
  @@index([patientId, issuedAt])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  receivedById String?
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @default(now())
  notes        String?
  createdAt    DateTime      @default(now())
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy   User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([invoiceId, paidAt])
  @@index([receivedById])
}

model UploadedFile {
  id            String       @id @default(cuid())
  clinicId      String
  patientId     String?
  appointmentId String?
  treatmentId   String?
  uploadedById  String?
  fileName      String
  storageKey    String       @unique
  mimeType      String
  sizeBytes     Int
  category      String?
  createdAt     DateTime     @default(now())
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  treatment     Treatment?   @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
  uploadedBy    User?        @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([patientId])
  @@index([appointmentId])
  @@index([treatmentId])
}
